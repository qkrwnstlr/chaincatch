<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingHorizontal="100dp"
  android:paddingVertical="30dp">

  <!-- background imgs -->
  <ImageView
    android:id="@+id/iv_top"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:src="@drawable/rounded_rectangle_top_for_sign_up_dialog"
    app:layout_constraintBottom_toTopOf="@id/iv_bottom"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_weight="2" />

  <!-- cancel button -->
  <ImageView
    android:id="@+id/sign_up_dialog_btn_cancel"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="30dp"
    android:adjustViewBounds="true"
    android:src="@drawable/btn_cancel3"
    app:layout_constraintBottom_toBottomOf="@id/tv_title"
    app:layout_constraintDimensionRatio="1"
    app:layout_constraintEnd_toEndOf="@id/iv_top"
    app:layout_constraintTop_toTopOf="@id/tv_title" />

  <ImageView
    android:id="@+id/iv_bottom_shadow"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:src="@drawable/rounded_rectangle_bottom_shadow_for_sign_up_dialog"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toBottomOf="@id/iv_top"
    app:layout_constraintVertical_weight="8" />

  <ImageView
    android:id="@+id/iv_bottom"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginBottom="10dp"
    android:src="@drawable/rounded_rectangle_bottom_for_sign_up_dialog"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toBottomOf="@id/iv_top"
    app:layout_constraintVertical_weight="8" />

  <!--  <ImageView-->
  <!--    android:id="@+id/iv_bottom_content"-->
  <!--    android:layout_width="match_parent"-->
  <!--    android:layout_height="0dp"-->
  <!--    android:layout_marginBottom="90dp"-->
  <!--    android:src="@drawable/rounded_rectangle_bottom_content_sign_up_dialog"-->
  <!--    app:layout_constraintBottom_toBottomOf="parent"-->
  <!--    app:layout_constraintTop_toBottomOf="@id/iv_top"-->
  <!--    app:layout_constraintVertical_weight="8" />-->


  <!-- title -->
  <TextView
    android:id="@+id/tv_title_shadow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_marginTop="7dp"
    android:text="어느 고양이로 플레이 할까요?"
    android:textColor="@color/white"
    android:textSize="22sp"
    android:textStyle="bold"
    app:layout_constraintBottom_toBottomOf="@id/iv_top"
    app:layout_constraintEnd_toEndOf="@id/iv_top"
    app:layout_constraintStart_toStartOf="@id/iv_top"
    app:layout_constraintTop_toTopOf="@id/iv_top" />

  <TextView
    android:id="@+id/tv_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginVertical="25dp"
    android:text="어느 고양이로 플레이 할까요?"
    android:textColor="#48390e"
    android:textSize="22sp"
    android:textStyle="bold"
    app:layout_constraintBottom_toBottomOf="@id/iv_top"
    app:layout_constraintEnd_toEndOf="@id/iv_top"
    app:layout_constraintStart_toStartOf="@id/iv_top"
    app:layout_constraintTop_toTopOf="@id/iv_top" />

  <!-- 냥이들 -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout_cats"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginHorizontal="30dp"
    android:layout_marginTop="35dp"
    app:layout_constraintBottom_toTopOf="@id/sign_up_layout_next_btns"
    app:layout_constraintTop_toTopOf="@id/iv_bottom"
    app:layout_constraintVertical_chainStyle="packed">

    <com.dtd.chaincatch.util.SignUpCardView
      android:id="@+id/cat_cheese"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:ivCat="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/cat_grey"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:tvCat="치즈냥이" />

    <com.dtd.chaincatch.util.SignUpCardView
      android:id="@+id/cat_grey"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:ivCat="@drawable/cat_grey_face"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/cat_fish"
      app:layout_constraintStart_toEndOf="@id/cat_cheese"
      app:layout_constraintTop_toTopOf="parent"
      app:tvCat="회색냥이" />

    <com.dtd.chaincatch.util.SignUpCardView
      android:id="@+id/cat_fish"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:ivCat="@drawable/cat_fish_face"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/cat_rainbow"
      app:layout_constraintStart_toEndOf="@id/cat_grey"
      app:layout_constraintTop_toTopOf="parent"
      app:tvCat="생선냥이" />

    <com.dtd.chaincatch.util.SignUpCardView
      android:id="@+id/cat_rainbow"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:ivCat="@drawable/cat_rainbow_face"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@id/cat_fish"
      app:layout_constraintTop_toTopOf="parent"
      app:tvCat="무지개냥이" />
  </androidx.constraintlayout.widget.ConstraintLayout>

  <!-- 닉네임 화면 -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/sign_up_layout_nickname"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginHorizontal="50dp"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="@id/iv_bottom"
    app:layout_constraintTop_toTopOf="@id/iv_bottom"
    tools:visibility="visible">

    <ImageView
      android:layout_width="match_parent"
      android:layout_height="50dp"
      android:layout_marginStart="5dp"
      android:layout_marginTop="5dp"
      android:src="@drawable/rounded_rectangle_grey_no_border"
      app:layout_constraintBottom_toBottomOf="@id/et_nickname"
      app:layout_constraintTop_toTopOf="@id/et_nickname" />

    <androidx.appcompat.widget.AppCompatEditText
      android:id="@+id/et_nickname"
      android:layout_width="match_parent"
      android:layout_height="50dp"
      android:layout_marginTop="20dp"
      android:background="@drawable/rounded_rectangle_white_no_border"
      android:fontFamily="@font/dunggeunmo"
      android:hint="닉네임을 입력해주세요 . . "
      android:paddingHorizontal="40dp"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@id/sign_up_dialog_btn_submit"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_chainStyle="packed" />

    <ImageView
      android:id="@+id/sign_up_dialog_btn_submit"
      android:layout_width="90dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="40dp"
      android:adjustViewBounds="true"
      android:src="@drawable/btn_submit2"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/et_nickname" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="3dp"
      android:text="확 인"
      android:textColor="#F1F1F1"
      android:textSize="16sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toBottomOf="@id/sign_up_dialog_btn_submit"
      app:layout_constraintEnd_toEndOf="@id/sign_up_dialog_btn_submit"
      app:layout_constraintStart_toStartOf="@id/sign_up_dialog_btn_submit"
      app:layout_constraintTop_toTopOf="@id/sign_up_dialog_btn_submit" />

  </androidx.constraintlayout.widget.ConstraintLayout>

  <!-- 다음 버튼 -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/sign_up_layout_next_btns"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_marginEnd="30dp"
    android:layout_marginBottom="20dp"
    app:layout_constraintBottom_toBottomOf="@id/iv_bottom"
    app:layout_constraintEnd_toEndOf="@id/iv_bottom"
    app:layout_constraintTop_toBottomOf="@id/layout_cats">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="10dp"
      android:gravity="center"
      android:text="다음"
      android:textSize="16sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toBottomOf="@id/btn_sign_up_next"
      app:layout_constraintEnd_toStartOf="@id/btn_sign_up_next"
      app:layout_constraintTop_toTopOf="@id/btn_sign_up_next" />

    <ImageView
      android:id="@+id/btn_sign_up_next"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:adjustViewBounds="true"
      android:src="@drawable/btn_next"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent" />
  </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>