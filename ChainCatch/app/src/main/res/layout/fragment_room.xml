<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".room.fragment.RoomFragment">

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/player_list"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <com.raed.rasmview.RasmView
    android:id="@+id/drawing_view"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toTopOf="@+id/bottom_layout"
    app:layout_constraintEnd_toStartOf="@+id/toolList"
    app:layout_constraintStart_toEndOf="@+id/player_list"
    app:layout_constraintTop_toTopOf="parent" />

  <ImageView
    android:id="@+id/imageView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toTopOf="@+id/bottom_layout"
    app:layout_constraintEnd_toStartOf="@+id/toolList"
    app:layout_constraintStart_toEndOf="@+id/player_list"
    app:layout_constraintTop_toTopOf="parent" />

  <LinearLayout
    android:id="@+id/bottom_layout"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toStartOf="@+id/toolList"
    app:layout_constraintStart_toEndOf="@+id/player_list">

    <EditText
      android:id="@+id/chatting_et"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1" />

    <Button
      android:id="@+id/startButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="게임 시작" />

    <TextView
      android:id="@+id/time_tv"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="00 : 30" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/toolList"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="0.0">

    <androidx.appcompat.widget.AppCompatButton
      android:id="@+id/color_btn"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:layout_margin="6dp"
      android:background="@color/black"/>

    <Button
      android:id="@+id/brush_btn"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:layout_margin="6dp"
      android:background="@drawable/icon_brush" />

    <Button
      android:id="@+id/undo_btn"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:layout_margin="6dp"
      android:background="@drawable/icon_undo" />

    <Button
      android:id="@+id/redo_btn"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:layout_margin="6dp"
      android:background="@drawable/icon_redo" />

    <Button
      android:id="@+id/clear_btn"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:layout_margin="6dp"
      android:background="@drawable/icon_clear" />
  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>