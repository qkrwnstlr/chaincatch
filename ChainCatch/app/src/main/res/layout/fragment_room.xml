<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#ECECEC"
  tools:context=".view.fragment.RoomFragment">

  <!-- 사용자 영역 -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/player_list"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:paddingStart="@dimen/game_room_root_padding_start_15"
    android:paddingTop="@dimen/game_room_play_list_and_balloon_margin_top_10"
    android:paddingEnd="@dimen/game_room_root_padding_end_5"
    android:paddingBottom="@dimen/game_room_play_list_and_balloon_padding_bottom_10"
    app:layout_constraintBottom_toTopOf="@id/layout_startButton"
    app:layout_constraintEnd_toStartOf="@id/layout_drawing"
    app:layout_constraintHorizontal_weight="1.8"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_weight="9">

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user1"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toTopOf="@id/user2"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user2"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toTopOf="@id/user3"
      app:layout_constraintTop_toBottomOf="@id/user1"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user3"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toTopOf="@id/user4"
      app:layout_constraintTop_toBottomOf="@id/user2"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user4"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toTopOf="@id/user5"
      app:layout_constraintTop_toBottomOf="@id/user3"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user5"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_no_user_face"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toBottomOf="@id/user4"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />
  </androidx.constraintlayout.widget.ConstraintLayout>

  <!-- 게임시작 버튼 -->
  <FrameLayout
    android:id="@+id/layout_startButton"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginEnd="10dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="@id/player_list"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/player_list"
    app:layout_constraintVertical_weight="1">

    <ImageView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginStart="@dimen/game_room_root_padding_start_15"
      android:layout_marginBottom="6dp"
      android:background="@drawable/btn_submit2" />

    <TextView
      android:id="@+id/startButton"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center"
      android:gravity="center"
      android:paddingStart="@dimen/game_room_root_padding_start_15"
      android:paddingBottom="8dp"
      android:text="시  작"
      android:textColor="@color/white"
      android:textStyle="bold" />
  </FrameLayout>


  <!-- 그림판 + 툴 영역 -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout_drawing"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="5dp"
    android:layout_marginTop="@dimen/game_room_root_padding_top_10"
    android:layout_marginEnd="15dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_weight="8.2"
    app:layout_constraintStart_toEndOf="@id/player_list"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_weight="8">

    <!-- questioner & solver 그림판 -->
    <include
      android:id="@+id/container_drawing_view"
      layout="@layout/view_dv_questioner"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:layout_constraintBottom_toTopOf="@id/bottom_layout"
      app:layout_constraintEnd_toStartOf="@id/toolList"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_weight="9" />

    <!-- 그림판 툴 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/toolList"
      android:layout_width="50dp"
      android:layout_height="0dp"
      android:paddingLeft="10dp"
      app:layout_constraintBottom_toBottomOf="@id/container_drawing_view"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <ImageView
        android:id="@+id/color_btn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_rectangle_black"
        app:layout_constraintBottom_toTopOf="@id/brush_btn"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintVertical_chainStyle="packed" />

      <Button
        android:id="@+id/brush_btn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:background="@drawable/icon_brush"
        app:layout_constraintBottom_toTopOf="@id/clear_btn"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintTop_toBottomOf="@id/color_btn" />

      <Button
        android:id="@+id/clear_btn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:background="@drawable/icon_clear"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintTop_toBottomOf="@id/brush_btn" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 채팅 영역 -->
    <LinearLayout
      android:id="@+id/bottom_layout"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:orientation="horizontal"
      android:paddingTop="6dp"
      android:paddingBottom="8dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="@id/container_drawing_view"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/container_drawing_view"
      app:layout_constraintVertical_weight="1.3">

      <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:layout_weight="1.8"
        android:gravity="center|start"
        android:text="CHATTING"
        android:textColor="#F44336"
        android:textSize="20sp" />

      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_weight="8.5"
        android:background="@drawable/rounded_rectangle_white_slim_border">

        <TextView
          android:id="@+id/chatting_tv"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_marginStart="16dp"
          android:gravity="center"
          android:text="> >"
          android:textColor="@color/white"
          android:textSize="16sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent" />

        <EditText
          android:id="@+id/chatting_et"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_marginStart="10dp"
          android:layout_marginEnd="20dp"
          android:background="@null"
          android:fontFamily="@font/dunggeunmo"
          android:imeOptions="actionSend|flagNoFullscreen"
          android:singleLine="true"
          android:textColor="@color/white"
          android:textSize="14sp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@id/chatting_tv"
          tools:text="채팅중" />
      </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>


  </androidx.constraintlayout.widget.ConstraintLayout>

  <!-- 말풍선 영역-->
  <LinearLayout
    android:id="@+id/layout_balloons"
    android:layout_width="150dp"
    android:layout_height="0dp"
    android:layout_marginTop="@dimen/game_room_play_list_and_balloon_margin_top_10"
    android:orientation="vertical"
    android:paddingBottom="@dimen/game_room_play_list_and_balloon_padding_bottom_10"
    app:layout_constraintBottom_toBottomOf="@id/player_list"
    app:layout_constraintStart_toEndOf="@id/player_list"
    app:layout_constraintTop_toTopOf="parent">

    <include
      android:id="@+id/balloon1"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"
      android:text="한줄당9글자제한??"
      tools:visibility="invisible" />

    <include
      android:id="@+id/balloon2"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"/>

    <include
      android:id="@+id/balloon3"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"/>

    <include
      android:id="@+id/balloon4"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"/>

    <include
      android:id="@+id/balloon5"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"/>
  </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>