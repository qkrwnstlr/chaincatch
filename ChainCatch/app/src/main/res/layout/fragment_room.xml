<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/black"
  tools:context=".view.fragment.RoomFragment">

  <!-- 사용자 영역 -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/player_list"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginStart="@dimen/game_room_root_margin_top_5"
    android:layout_marginTop="@dimen/game_room_play_list_and_balloon_margin_top_10"
    app:layout_constraintBottom_toTopOf="@id/bottom_layout"
    app:layout_constraintEnd_toStartOf="@id/layout_drawing"
    app:layout_constraintHorizontal_weight="2"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    tools:background="#27FF0000">

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user1"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toTopOf="@id/user2"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user2"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toTopOf="@id/user3"
      app:layout_constraintTop_toBottomOf="@id/user1"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user3"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toTopOf="@id/user4"
      app:layout_constraintTop_toBottomOf="@id/user2"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user4"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_cheese_face"
      app:layout_constraintBottom_toTopOf="@id/user5"
      app:layout_constraintTop_toBottomOf="@id/user3"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />

    <com.dtd.chaincatch.widget.UserCardView
      android:id="@+id/user5"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:ivUser="@drawable/cat_no_user_face"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toBottomOf="@id/user4"
      app:layout_constraintVertical_weight="1"
      app:tvAnswerCnt="0"
      app:tvNickname="닉네임" />
  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/startButton"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_margin="5dp"
    android:text="게임 시작"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="@id/player_list"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/player_list" />

  <!-- 그림판 + 툴 영역 -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout_drawing"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginStart="@dimen/fragment_home_root_margin_start_20"
    android:layout_marginTop="@dimen/game_room_root_margin_top_5"
    app:layout_constraintBottom_toTopOf="@id/bottom_layout"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_weight="8"
    app:layout_constraintStart_toEndOf="@id/player_list"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_weight="8">

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="10dp"
      android:padding="10dp"
      app:layout_constraintEnd_toStartOf="@id/toolList"
      app:layout_constraintStart_toStartOf="parent">

      <!-- questioner 그림판 -->
      <com.raed.rasmview.RasmView
        android:id="@+id/dv_questioner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        tools:background="#BBC9FD" />

      <!-- solver 그림판 -->
      <ImageView
        android:id="@+id/iv_solver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        android:adjustViewBounds="true"
        android:visibility="gone"
        tools:background="#FFDB9C" />
    </FrameLayout>


    <!-- 그림판 툴 영역 -->
    <LinearLayout
      android:id="@+id/toolList"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:background="@color/white"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/color_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="6dp"
        android:background="@color/black" />

      <Button
        android:id="@+id/brush_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="6dp"
        android:background="@drawable/icon_brush" />

      <Button
        android:id="@+id/undo_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="6dp"
        android:background="@drawable/icon_undo" />

      <Button
        android:id="@+id/redo_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="6dp"
        android:background="@drawable/icon_redo" />

      <Button
        android:id="@+id/clear_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="6dp"
        android:background="@drawable/icon_clear" />
    </LinearLayout>

    <!-- 문제 -->
    <TextView
      android:id="@+id/question_tv"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:layout_marginEnd="16dp"
      android:textSize="24sp"
      app:layout_constraintEnd_toStartOf="@id/toolList"
      app:layout_constraintTop_toTopOf="parent"
      tools:text="문제" />
  </androidx.constraintlayout.widget.ConstraintLayout>

  <!-- 말풍선 영역-->
  <LinearLayout
    android:id="@+id/layout_balloons"
    android:layout_width="150dp"
    android:layout_height="0dp"
    android:layout_marginTop="@dimen/game_room_play_list_and_balloon_margin_top_10"
    android:orientation="vertical"
    app:layout_constraintBottom_toBottomOf="@id/player_list"
    app:layout_constraintStart_toEndOf="@id/player_list"
    app:layout_constraintTop_toTopOf="parent">

    <include
      android:id="@+id/balloon1"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"
      android:text="한줄당9글자제한??"
      tools:visibility="visible" />

    <include
      android:id="@+id/balloon2"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"
      android:visibility="invisible"
      tools:visibility="visible" />

    <include
      android:id="@+id/balloon3"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"
      android:visibility="invisible"
      tools:visibility="visible" />

    <include
      android:id="@+id/balloon4"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"
      android:visibility="invisible"
      tools:visibility="visible" />

    <include
      android:id="@+id/balloon5"
      layout="@layout/chatting_bubble"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@drawable/balloon2_nine_patch"
      android:visibility="invisible"
      tools:visibility="visible" />
  </LinearLayout>

  <!-- 채팅, 게임시작 버튼, 타이머 영역 -->
  <LinearLayout
    android:id="@+id/bottom_layout"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="horizontal"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toEndOf="@id/player_list"
    app:layout_constraintTop_toBottomOf="@id/layout_drawing"
    app:layout_constraintVertical_weight="1">

    <TextView
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_gravity="end|center_vertical"
      android:layout_marginStart="@dimen/fragment_home_root_margin_start_20"
      android:layout_weight="2"
      android:gravity="center"
      android:text="CHATTING"
      android:textColor="#E80000"
      android:textSize="20sp" />

    <EditText
      android:id="@+id/chatting_et"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginVertical="@dimen/game_room_ev_chatting_margin_vertical_5"
      android:layout_weight="8"
      android:background="@drawable/rounded_rectangle_white_no_border"
      android:imeOptions="flagNoExtractUi"
      android:paddingHorizontal="20dp"
      android:paddingVertical="1dp"
      android:textCursorDrawable="@null" />

    <TextView
      android:id="@+id/time_tv"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_marginHorizontal="10dp"
      android:gravity="center_vertical"
      android:text="00 : 30"
      android:textColor="@color/white"
      android:textSize="24sp"
      android:textStyle="bold" />
  </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>