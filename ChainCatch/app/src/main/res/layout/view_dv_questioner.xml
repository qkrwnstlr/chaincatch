<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/black">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/game_room_drawing_view_pixel_size_8"
    android:background="#babeca">

    <View
      android:layout_width="@dimen/game_room_drawing_view_pixel_size_16"
      android:layout_height="0dp"
      android:background="#ecf5fd"
      app:layout_constraintBottom_toTopOf="@id/view_skyblue"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/view_skyblue"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginTop="@dimen/game_room_drawing_view_pixel_size_8"
      android:layout_marginEnd="@dimen/game_room_drawing_view_pixel_size_8"
      android:layout_marginBottom="@dimen/game_room_drawing_view_pixel_size_8"
      android:background="#ecf5fd">

      <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_inner_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/game_room_drawing_view_pixel_size_16"
        android:layout_marginEnd="@dimen/game_room_drawing_view_pixel_size_8"
        android:layout_marginBottom="@dimen/game_room_drawing_view_pixel_size_16"
        android:background="@color/black">

        <!-- questioner 그림판 -->
        <com.raed.rasmview.RasmView
          android:id="@+id/dv_questioner"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_margin="@dimen/game_room_drawing_view_pixel_size_8"
          tools:visibility="gone" />

        <!-- solver 그림판 -->
        <ImageView
          android:id="@+id/iv_solver"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_margin="@dimen/game_room_drawing_view_pixel_size_8"
          android:adjustViewBounds="true"
          android:background="@color/white"
          android:visibility="gone"
          tools:visibility="visible" />

        <!-- undo / redo 버튼 -->
        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="wrap_content"
          android:layout_height="40dp"
          android:layout_marginEnd="12dp"
          android:layout_marginBottom="2dp"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent">

          <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/undo_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:background="@drawable/icon_undo"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toStartOf="@id/redo_btn"
            app:layout_constraintStart_toStartOf="parent" />

          <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/redo_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:background="@drawable/icon_redo"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/undo_btn" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- 문제 -->
        <TextView
          android:id="@+id/question_tv"
          android:layout_width="wrap_content"
          android:layout_height="0dp"
          android:background="#12897e"
          android:gravity="center"
          android:paddingHorizontal="12dp"
          android:text="문제"
          android:textColor="@color/white"
          android:textSize="16sp"
          app:layout_constraintBottom_toBottomOf="@id/time_tv"
          app:layout_constraintEnd_toStartOf="@id/time_tv"
          app:layout_constraintTop_toTopOf="@id/time_tv" />

        <!-- 타이머 -->
        <TextView
          android:id="@+id/time_tv"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:layout_marginEnd="14dp"
          android:background="#CF0F0F"
          android:fontFamily="@font/dunggeunmo"
          android:gravity="center_vertical"
          android:paddingHorizontal="12dp"
          android:paddingVertical="4dp"
          android:text="00 : 00"
          android:textColor="@color/white"
          android:textSize="18sp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

      </androidx.constraintlayout.widget.ConstraintLayout>

      <View
        android:id="@+id/black_pixel_1"
        android:layout_width="@dimen/game_room_drawing_view_pixel_size_8"
        android:layout_height="@dimen/game_room_drawing_view_pixel_size_8"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/view_inner_black" />

      <View
        android:id="@+id/black_pixel_2"
        android:layout_width="@dimen/game_room_drawing_view_pixel_size_24"
        android:layout_height="@dimen/game_room_drawing_view_pixel_size_8"
        android:layout_marginStart="@dimen/game_room_drawing_view_pixel_size_8"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/black_pixel_1" />

      <View
        android:id="@+id/black_pixel_3"
        android:layout_width="@dimen/game_room_drawing_view_pixel_size_8"
        android:layout_height="@dimen/game_room_drawing_view_pixel_size_8"
        android:layout_marginStart="@dimen/game_room_drawing_view_pixel_size_8"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/black_pixel_2" />

      <View
        android:id="@+id/red_pixel"
        android:layout_width="@dimen/game_room_drawing_view_pixel_size_32"
        android:layout_height="@dimen/game_room_drawing_view_pixel_size_8"
        android:layout_marginStart="@dimen/game_room_drawing_view_pixel_size_8"
        android:background="#FF0000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/view_inner_black" />

    </androidx.constraintlayout.widget.ConstraintLayout>


  </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>